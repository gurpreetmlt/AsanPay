<?xml version="1.0" encoding="utf-8"?>
<!-- Debug only: cleartext to localhost for Metro and the dev API over `adb reverse`.
     Overrides src/main/res/xml/network_security_config.xml, which has no cleartext exceptions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <domain-config>
        <domain includeSubdomains="false">api.asanpay.in</domain>
        <pin-set expiration="2027-07-17">
            <pin digest="SHA-256">nWN7PSep5XDQdge5zK24CnCRXHr3KvzhKEGxsdqCX9E=</pin>
            <pin digest="SHA-256">fk6IOKit1ild5647BH06ujSIq5XbCgqlbYl6ANhhi88=</pin>
        </pin-set>
    </domain-config>
</network-security-config>
