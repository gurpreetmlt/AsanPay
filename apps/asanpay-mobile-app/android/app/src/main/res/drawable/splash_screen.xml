<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 full-window splash — blue + corner glows (React pattern) + wallet -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <!-- Top-right glow (ScreenHeader / wallet card pattern) -->
    <item
        android:width="220dp"
        android:height="220dp"
        android:gravity="top|end"
        android:top="-70dp"
        android:right="-40dp">
        <shape android:shape="oval">
            <solid android:color="@color/splash_glow" />
        </shape>
    </item>

    <!-- Soft top-left glow -->
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="top|start"
        android:top="80dp"
        android:left="-90dp">
        <shape android:shape="oval">
            <solid android:color="@color/splash_glow_soft" />
        </shape>
    </item>

    <!-- Soft bottom-left glow -->
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="bottom|start"
        android:bottom="-60dp"
        android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="@color/splash_glow_soft" />
        </shape>
    </item>

    <!-- Center wallet mark -->
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@mipmap/ic_launcher_foreground" />
</layer-list>
