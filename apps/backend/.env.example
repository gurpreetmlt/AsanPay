NODE_ENV=development
PORT=4000

# PostgreSQL — single database: wallets, ledger, transactions, commission,
# hierarchy, service catalog, audit logs, OTP requests, provider logs
DATABASE_URL=postgres://asanpay:asanpay@localhost:5432/asanpay

# Redis — OPTIONAL, cache only (hot reads / short TTL). Not for queues or primary data.
# REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# AES-256-GCM key for encrypting PAN/Aadhaar at rest — must be exactly 32 bytes, base64-encoded
AES_ENCRYPTION_KEY=change-me-32-byte-base64-key

CORS_ORIGIN=http://localhost:3000

# Dev-only: echo OTP in API JSON for local testing (ignored in production).
EXPOSE_OTP_IN_RESPONSE=true
# Dev-only: fixed OTP per number "mobile:otp,mobile:otp"; "*:123456" applies to all.
TEST_OTP_OVERRIDES=*:123456

# OTP delivery until SMS is live: telegram (and optional log). SMS later.
# OTP_DELIVERY=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=AsanPayAuthBot
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PUBLIC_URL=https://api.asanpay.in

# Seed scripts (required — no hardcoded passwords in source)
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_MOBILE=9999999999
# SEED_LOGIN_MPIN=

# Allow stub/mock provider adapters to serve traffic in production. Default false.
# SECURITY: mocks return "success" for any AEPS/DMT/BBPS call with no real bank payout, so with
# this on in prod a retailer could mint wallet float. Only enable in dev/staging.
ALLOW_STUB_PROVIDERS=false

# Auto-recheck pending / crash-stale initiated txns (ms). 0 = disable. Default 5 minutes.
# TXN_RECONCILE_INTERVAL_MS=300000

# Hard ceiling (rupees) on a single admin manual wallet top-up. Manual funding mints float,
# so an unbounded call is the biggest single-action money risk. A dual-approval workflow should
# replace this ceiling before scale.
MAX_MANUAL_FUND_RUPEES=500000

# InstantPay (UPI Cash Point / UPI ATM) — real provider, not a mock. Get these from the
# InstantPay Portal → Developer APIs → Credentials. Separate Client Secret per environment
# (Sandbox vs Production) — confirm which one you were issued before going live.
# INSTANTPAY_CLIENT_ID=
# INSTANTPAY_CLIENT_SECRET=
# INSTANTPAY_OUTLET_ID=

# VyaparAPI (Mobile prepaid / DTH recharge). Portal → API key. Coolify backend env.
# VYAPARAPI_API_KEY=
# VYAPARAPI_BASE_URL=https://api.vyaparapi.com
# Partner callback URL: https://<backend-host>/api/webhooks/vyaparapi/callback?token=<secret>
# VYAPARAPI_CALLBACK_SECRET=
