# AsanPay — Environment

# Database — single PostgreSQL instance for all data
DATABASE_URL=postgresql://asanpay:asanpay@localhost:5432/asanpay

# Auth
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Provider API keys (never commit real values)
NOBLE_API_KEY=
NOBLE_API_VALUE=

# Portal URLs
ADMIN_URL=http://localhost:3000
AGENT_WEB_URL=http://localhost:3001
API_URL=http://localhost:4000

# Mobile (Android) — point to VPS in production
# API_URL=https://api.asanpay.com
